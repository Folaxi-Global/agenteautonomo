---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { supabase } from '../core/db_client'; // Tu cliente centralizado

// Conectar a Supabase y obtener todos los proyectos activos
// Esto se ejecuta en el servidor al generar la página
const { data: proyectos, error } = await supabase
  .from('proyectos')
  .select('*')
  .eq('estado', 'activo')
  .order('fecha_creacion', { ascending: false });

if (error) {
  console.error('Error fetching projects:', error);
}
---

<Layout title="Directorio de Soluciones">
  <section class="py-16 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4">
      <div class="mb-12 border-b border-gray-200 pb-8">
        <h1 class="text-5xl font-extrabold tracking-tighter text-gray-950">Catálogo de Herramientas</h1>
        <p class="mt-4 text-xl text-gray-600">Encuentra la solución digital diseñada para tu industria y país en Latinoamérica.</p>
      </div>

      {error && (
        <p class="text-red-600 bg-red-100 p-4 rounded-lg">Hubo un problema al cargar el directorio. Por favor intenta más tarde.</p>
      )}

      <!-- Grid de tarjetas -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {proyectos && proyectos.map((p) => (
          <ProjectCard 
            nombre={p.nombre_proyecto}
            descripcion={p.descripcion_oferta}
            pais={p.pais_objetivo}
            subdominio={p.subdominio}
          />
        ))}
      </div>

      {!proyectos || (proyectos.length === 0 && !error) && (
        <div class="text-center py-16 bg-white rounded-2xl border border-gray-200">
          <h3 class="text-2xl font-bold text-gray-700">Pronto más soluciones</h3>
          <p class="mt-2 text-gray-500">Estamos lanzando nuevas herramientas constantemente para LatAm.</p>
        </div>
      )}
    </div>
  </section>
</Layout>
