---
// Importamos una fuente moderna (Geist Sans es muy pro, si no, usa Inter)
// Necesitarás instalar el paquete: npm install @fontsource/geist-sans
import '@fontsource/geist-sans/400.css';
import '@fontsource/geist-sans/700.css';
import '../styles/global.css';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Ecosistema digital de Vartens. Holding de micro-SaaS para Latinoamérica." />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} | Vartens - Ecosistema Tecnológico</title>
	</head>
	<body class="bg-gray-50 text-gray-950 antialiased selection:bg-blue-100 font-sans">
		<!-- Fondo sutil de dots tipo "tecnología" -->
		<div class="absolute inset-0 -z-10 h-full w-full bg-gray-50 bg-[radial-gradient(#e5e7eb_1px,transparent_1px)] [background-size:16px_16px] opacity-40"></div>
		
		<slot />

		<!-- Footer minimalista "Pro" -->
		<footer class="border-t border-gray-200 bg-white mt-auto py-10">
			<div class="max-w-7xl mx-auto px-6 text-center text-gray-500 text-sm">
				<p>&copy; {new Date().getFullYear()} Vartens Technologies. Todos los derechos reservados.</p>
				<p class="mt-2">Construyendo el futuro de Latinoamérica.</p>
			</div>
		</footer>
	</body>
</html>

<style is:global>
	/* Aplicamos la fuente importada globalmente */
	:root {
		--font-geist: 'Geist Sans', sans-serif;
		--vartens-blue: 37, 99, 235; /* Un azul más vibrante */
	}
	
	body {
		font-family: var(--font-geist);
		display: flex;
		flex-direction: column;
		min-height: 100vh;
	}

    @tailwind base;
    @tailwind components;
    @tailwind utilities;
</style>
