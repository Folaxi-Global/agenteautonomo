---
import '../styles/global.css';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth antialiased">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Ecosistema digital de Vartens. Holding de micro-SaaS para Latinoamérica." />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} | Vartens - Ecosistema Tecnológico</title>
	</head>
	<body class="bg-gray-50 text-gray-950 font-sans">
		<!-- Fondo sutil de dots tipo "tecnología" -->
		<div class="fixed inset-0 -z-10 h-full w-full bg-gray-50 bg-[radial-gradient(#e5e7eb_1px,transparent_1px)] [background-size:16px_16px] opacity-40"></div>
		
		<div class="relative flex min-h-screen flex-col">
			<slot />
		</div>

		<!-- Footer minimalista "Pro" -->
		<footer class="border-t border-gray-200 bg-white/80 backdrop-blur-sm py-10 mt-auto">
			<div class="max-w-7xl mx-auto px-6 text-center text-gray-500 text-sm">
				<p>&copy; {new Date().getFullYear()} Vartens Technologies. Todos los derechos reservados.</p>
				<p class="mt-2">Construyendo el futuro de Latinoamérica.</p>
			</div>
		</footer>
	</body>
</html>

<style is:global>
	/* Aseguramos que las fuentes del sistema carguen bien */
	:root {
		--font-sans: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
	}
	
	body {
		font-family: var(--font-sans);
	}

    @tailwind base;
    @tailwind components;
    @tailwind utilities;
</style>
