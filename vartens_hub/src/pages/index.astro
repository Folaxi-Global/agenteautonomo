---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Impulsa tu Negocio en Latinoamérica">
  <div class="relative isolate overflow-hidden bg-white">
    <div class="px-6 py-24 sm:px-6 sm:py-32 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <h1 class="text-5xl font-extrabold tracking-tighter text-gray-950 sm:text-7xl leading-tight">
          El Ecosistema Digital de <br />
          <span class="text-blue-600">Vartens</span>
        </h1>
        <p class="mx-auto mt-8 max-w-xl text-xl leading-8 text-gray-600">
          Estamos construyendo y operando 100 micro-SaaS especializados para resolver dolores agudos de PYMEs en Latinoamérica. Automatización inteligente para escalar tu negocio.
        </p>
        <div class="mt-12 flex items-center justify-center gap-x-6">
          <a href="/directorio" class="rounded-xl bg-blue-600 px-8 py-4 text-lg font-semibold text-white shadow-sm hover:bg-blue-500 transition">
            Explorar Soluciones
          </a>
          <a href="mailto:alianzas@vartens.com" class="text-lg font-semibold leading-6 text-gray-900">
            Contacto Alianzas <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</Layout>
