---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Impulsa tu Negocio en Latinoamérica">
  <div class="relative isolate overflow-hidden bg-white">
    <div class="px-6 py-24 sm:px-6 sm:py-32 lg:px-8">
      <div class="mx-auto max-w-4xl text-center">
        
        <!-- Etiqueta superior / Indicador de actividad -->
        <div class="mb-8 inline-flex items-center rounded-full border border-green-200 bg-green-50 px-4 py-1.5 text-sm font-medium text-green-700">
          <span class="relative flex h-2 w-2 mr-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-green-500"></span>
          </span>
          Factoría de IA en Operación
        </div>

        <!-- Titular Principal (H1) - Mucho más directo y potente -->
        <h1 class="text-5xl font-extrabold tracking-tighter text-gray-950 sm:text-7xl leading-[1.1]">
          Automatizamos tu Negocio <br />
          <span class="text-blue-600">Creando 100 Micro-SaaS</span>
        </h1>
        
        <!-- Subtítulo (Párrafo) - Explica el mecanismo y el mercado -->
        <p class="mx-auto mt-10 max-w-2xl text-xl leading-9 text-gray-600 font-normal">
          En Folaxi Global/Vartens, construimos y operamos 100 soluciones de software ultra-especializadas. Usamos Inteligencia Artificial para resolver dolores agudos de PYMEs en Latinoamérica, escalando tu negocio en piloto automático.
        </p>
        
        <!-- Botones de Acción - Claros y orientados a la conversión -->
        <div class="mt-14 flex items-center justify-center gap-x-8">
          <a href="/directorio" class="group rounded-xl bg-blue-600 px-9 py-4 text-lg font-semibold text-white shadow-sm hover:bg-blue-500 transition-all flex items-center">
            Ver Nuestras Soluciones
            <svg class="ml-2 w-5 h-5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
          </a>
          <a href="mailto:alianzas@vartens.com" class="text-lg font-semibold leading-6 text-gray-900 group flex items-center">
            Contacto Alianzas 
            <span aria-hidden="true" class="ml-2 transition-transform group-hover:translate-x-1">→</span>
          </a>
        </div>
        
        <!-- Sección de confianza (Opcional, tipo "Backed by AURA") -->
        <div class="mt-20 pt-10 border-t border-gray-100 max-w-xl mx-auto text-center text-gray-500">
          <p>Impulsado por nuestra IA central, AURA.</p>
          <div class="mt-4 text-sm text-gray-400">5 Nuevos SaaS Lanzados Diariamente</div>
        </div>

      </div>
    </div>
  </div>
</Layout>
