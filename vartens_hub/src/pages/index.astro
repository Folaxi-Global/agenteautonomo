---
import Layout from '../layouts/Layout.astro';
import { createClient } from '@supabase/supabase-js';

// Inicialización de la conexión a tu base de datos
const supabase = createClient(
  import.meta.env.SUPABASE_URL,
  import.meta.env.SUPABASE_KEY
);

// Consulta los proyectos que están activos para mostrarlos en el catálogo
const { data: proyectos } = await supabase
  .from('proyectos')
  .select('*')
  .eq('estado', 'activo')
  .order('fecha_creacion', { ascending: false });
---

<Layout title="Impulsa tu Negocio en Latinoamérica">
  <div class="relative isolate overflow-hidden bg-white text-gray-900 selection:bg-blue-600 selection:text-white">
    
    <!-- Header Pro -->
    <header class="bg-white/80 backdrop-blur-md sticky top-0 z-50 border-b border-gray-100 shadow-xs">
      <nav class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <a href="/" class="flex items-center gap-3 group">
            <img src="/logo.jpg" alt="Vartens Logo" class="h-10 w-auto rounded-xl object-contain shadow-sm group-hover:scale-105 transition-transform" />
          </a>
          <span class="text-gray-300">/</span>
          <span class="text-sm font-medium text-gray-500 hidden sm:inline-block">Ecosistema Tecnológico</span>
        </div>
        <div class="flex items-center gap-6">
            <a href="#catalogo" class="text-sm font-semibold text-gray-700 hover:text-blue-600 transition">Ver Soluciones</a>
            <a href="#vision" class="text-sm font-medium text-gray-600 hover:text-blue-600 transition hidden md:inline-block">Nuestra Visión</a>
            <a href="mailto:alianzas@vartens.com" class="rounded-xl bg-blue-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-blue-700 transition-all shadow-blue-500/20">Contacto Alianzas</a>
        </div>
      </nav>
    </header>

    <div class="absolute inset-0 -z-10 h-full w-full bg-white bg-[radial-gradient(#e5e7eb_1px,transparent_1px)] [background-size:16px_16px] opacity-50"></div>

    <!-- Hero Section -->
    <div class="px-6 py-24 sm:px-6 sm:py-32 lg:px-8">
      <div class="mx-auto max-w-4xl text-center">
        <div class="mb-10 inline-flex items-center rounded-full border border-gray-200 bg-white px-5 py-2 text-sm font-medium text-gray-800 shadow-sm transition-all">
          <span class="relative flex h-2.5 w-2.5 mr-3">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-gray-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-gray-500"></span>
          </span>
          Ecosistema Vartens | Soluciones Digitales Especializadas para PYMEs LatAm
        </div>

        <h1 class="text-6xl font-extrabold tracking-tighter text-gray-950 sm:text-8xl leading-[1.1]">
          Potencia tu Negocio con<br />
          <span class="text-blue-600">Micro-SaaS Especializados</span>
        </h1>
        
        <p class="mx-auto mt-12 max-w-3xl text-2xl leading-9 text-gray-600 font-normal antialiased">
          En Vartens, desarrollamos herramientas digitales listas para usar, diseñadas para resolver los dolores agudos de las PYMEs. Automatizamos procesos en piloto automático.
        </p>
        
        <div class="mt-16 flex flex-col sm:flex-row items-center justify-center gap-6 sm:gap-x-10">
          <a href="#catalogo" class="w-full sm:w-auto group relative rounded-2xl bg-blue-600 px-10 py-5 text-xl font-semibold text-white shadow-xl shadow-blue-500/20 transition-all duration-300 hover:bg-blue-700 hover:shadow-blue-600/30 hover:-translate-y-1 flex items-center justify-center">
            Ver Nuestras Soluciones
          </a>
        </div>
      </div>
    </div>

    <!-- CATÁLOGO DINÁMICO DE MICRO-SAAS -->
    <section id="catalogo" class="py-24 bg-gray-50/50 border-t border-gray-100">
      <div class="max-w-7xl mx-auto px-6">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <h2 class="text-4xl font-extrabold text-gray-950 tracking-tight">Catálogo de Soluciones Activas</h2>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          {proyectos && proyectos.map((p) => (
            <div class="bg-white p-8 rounded-3xl border border-gray-200 shadow-sm hover:shadow-xl transition-all flex flex-col justify-between">
              <div>
                <span class="inline-block px-3 py-1 text-xs font-bold bg-blue-50 text-blue-700 rounded-full mb-4">{p.pais_objetivo}</span>
                <h3 class="text-2xl font-bold text-gray-950">{p.nombre_proyecto}</h3>
                <p class="mt-3 text-gray-600 text-sm leading-relaxed">{p.descripcion_oferta}</p>
              </div>
              <div class="mt-8 pt-6 border-t border-gray-100 flex items-center justify-between">
                <div>
                  <span class="text-xs text-gray-400 block">Inversión mensual</span>
                  <span class="text-lg font-extrabold text-gray-950">{p.precio_mensual} {p.moneda}</span>
                </div>
                <a href={`https://${p.subdominio}.vartens.com`} target="_blank" class="rounded-xl bg-gray-950 px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-blue-600 transition-all">
                  Probar Solución →
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Propuesta de Valor -->
    <section id="vision" class="py-20 bg-white border-t border-gray-100">
      <div class="max-w-7xl mx-auto px-6">
        <div class="text-center max-w-2xl mx-auto mb-16">
          <h2 class="text-3xl sm:text-4xl font-extrabold text-gray-950">Nuestra Propuesta de Valor</h2>
        </div>
        <div class="grid md:grid-cols-3 gap-8">
          <div class="bg-gray-50/50 p-8 rounded-3xl border border-gray-100 shadow-sm">
            <h3 class="text-xl font-bold text-gray-950">Listos para Operar</h3>
            <p class="mt-3 text-gray-600 text-sm">Herramientas digitales activas desde el primer día.</p>
          </div>
          <div class="bg-gray-50/50 p-8 rounded-3xl border border-gray-100 shadow-sm">
            <h3 class="text-xl font-bold text-gray-950">Especialización LatAm</h3>
            <p class="mt-3 text-gray-600 text-sm">Adaptadas a la realidad operativa de la región.</p>
          </div>
          <div class="bg-gray-50/50 p-8 rounded-3xl border border-gray-100 shadow-sm">
            <h3 class="text-xl font-bold text-gray-950">Piloto Automático</h3>
            <p class="mt-3 text-gray-600 text-sm">Automatiza procesos de ventas y gestión.</p>
          </div>
        </div>
      </div>
    </section>

    <footer class="border-t border-gray-100 bg-white py-12">
      <div class="max-w-7xl mx-auto px-6 text-center text-gray-500 text-sm">
        &copy; {new Date().getFullYear()} Vartens Technologies. Todos los derechos reservados.
      </div>
    </footer>
  </div>
</Layout>

<style>
    body { font-family: Inter, system-ui, -apple-system, sans-serif; }
</style>
