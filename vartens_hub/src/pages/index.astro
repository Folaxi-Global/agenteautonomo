---
import Layout from '../layouts/Layout.astro';
import { createClient } from '@supabase/supabase-js';

// Inicialización segura para evitar errores de build en Vercel
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
const supabaseKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
let proyectos = [];

if (supabaseUrl && supabaseKey) {
  const supabase = createClient(supabaseUrl, supabaseKey);
  const { data, error } = await supabase
    .from('proyectos')
    .select('*')
    .eq('estado', 'activo')
    .order('fecha_creacion', { ascending: false });
  
  if (!error) proyectos = data || [];
}
---

<Layout title="Impulsa tu Negocio en Latinoamérica">
  <div class="relative isolate overflow-hidden bg-white text-gray-900 selection:bg-blue-600 selection:text-white">
    
    <!-- Header Pro -->
    <header class="bg-white/80 backdrop-blur-md sticky top-0 z-50 border-b border-gray-100 shadow-xs">
      <nav class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <a href="/" class="flex items-center gap-3 group">
            <img src="/logo.jpg" alt="Vartens Logo" class="h-10 w-auto rounded-xl object-contain shadow-sm group-hover:scale-105 transition-transform" />
          </a>
          <span class="text-sm font-medium text-gray-500 hidden sm:inline-block">/ Ecosistema Tecnológico</span>
        </div>
        <div class="flex items-center gap-6">
            <a href="#catalogo" class="text-sm font-semibold text-gray-700 hover:text-blue-600 transition">Ver Soluciones</a>
            <a href="mailto:alianzas@vartens.com" class="rounded-xl bg-blue-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-blue-700 transition-all">Contacto Alianzas</a>
        </div>
      </nav>
    </header>

    <div class="absolute inset-0 -z-10 h-full w-full bg-white bg-[radial-gradient(#e5e7eb_1px,transparent_1px)] [background-size:16px_16px] opacity-50"></div>

    <!-- Hero Section -->
    <div class="px-6 py-24 text-center">
        <div class="mb-10 inline-flex items-center rounded-full border border-gray-200 bg-white px-5 py-2 text-sm font-medium text-gray-800 shadow-sm">
          Ecosistema Vartens | Soluciones Digitales Especializadas para PYMEs LatAm
        </div>
        <h1 class="text-6xl font-extrabold tracking-tighter text-gray-950 sm:text-8xl leading-[1.1]">
          Potencia tu Negocio con<br />
          <span class="text-blue-600">Micro-SaaS Especializados</span>
        </h1>
        <p class="mx-auto mt-12 max-w-3xl text-2xl leading-9 text-gray-600 font-normal">
          Desarrollamos herramientas digitales listas para usar, diseñadas para resolver dolores agudos en Latinoamérica. Automatización en piloto automático.
        </p>
    </div>

    <!-- CATÁLOGO DINÁMICO INTEGRADO -->
    <section id="catalogo" class="py-24 bg-gray-50/50 border-t border-gray-100">
      <div class="max-w-7xl mx-auto px-6">
        <h2 class="text-4xl font-extrabold text-center mb-16">Catálogo de Soluciones</h2>
        <div class="grid md:grid-cols-3 gap-8">
          {proyectos.length > 0 ? proyectos.map((p) => (
            <div class="bg-white p-8 rounded-3xl border border-gray-200 shadow-sm hover:shadow-xl transition-all">
              <span class="text-xs font-bold bg-blue-50 text-blue-700 px-3 py-1 rounded-full">{p.pais_objetivo}</span>
              <h3 class="text-2xl font-bold mt-4">{p.nombre_proyecto}</h3>
              <p class="mt-3 text-gray-600 text-sm">{p.descripcion_oferta}</p>
              <div class="mt-8 pt-6 border-t flex justify-between items-center">
                <span class="font-bold text-lg">{p.precio_mensual} {p.moneda}</span>
                <a href={`https://${p.subdominio}.vartens.com`} target="_blank" class="text-blue-600 font-semibold hover:underline">Acceder →</a>
              </div>
            </div>
          )) : (
            <p class="text-center col-span-3 text-gray-500">Cargando catálogo en tiempo real...</p>
          )}
        </div>
      </div>
    </section>

    <!-- Visión -->
    <section id="vision" class="py-20 bg-white border-t border-gray-100">
      <div class="max-w-7xl mx-auto px-6 grid md:grid-cols-3 gap-8 text-center">
        <div class="bg-gray-50/50 p-8 rounded-3xl border">
          <h3 class="text-xl font-bold">Listos para Operar</h3>
          <p class="mt-2 text-sm text-gray-600">Sin configuraciones técnicas complejas.</p>
        </div>
        <div class="bg-gray-50/50 p-8 rounded-3xl border">
          <h3 class="text-xl font-bold">Especialización LatAm</h3>
          <p class="mt-2 text-sm text-gray-600">Adaptadas a la realidad de la región.</p>
        </div>
        <div class="bg-gray-50/50 p-8 rounded-3xl border">
          <h3 class="text-xl font-bold">Piloto Automático</h3>
          <p class="mt-2 text-sm text-gray-600">Automatiza ventas y gestión.</p>
        </div>
      </div>
    </section>

    <footer class="border-t bg-white py-12 text-center text-sm text-gray-500">
      &copy; {new Date().getFullYear()} Vartens Technologies.
    </footer>
  </div>
</Layout>

<style>
    body { font-family: Inter, system-ui, -apple-system, sans-serif; }
</style>
