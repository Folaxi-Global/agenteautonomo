---
import Layout from '../layouts/Layout.astro';
import { createClient } from '@supabase/supabase-js';

// Inicialización de la conexión
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
const supabaseKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;

let saas_list = [];

// Conexión dinámica a tu tabla de proyectos
if (supabaseUrl && supabaseKey) {
  const supabase = createClient(supabaseUrl, supabaseKey);
  const { data } = await supabase
    .from('proyectos')
    .select('*')
    .eq('estado', 'activo')
    .order('fecha_creacion', { ascending: false });
  saas_list = data || [];
}

// Generar categorías dinámicamente según lo que tengas en la base de datos
const categories = ['Todos', ...new Set(saas_list.map(item => item.estado || 'General'))];
---

<Layout title="Directorio de Soluciones Vartens">
  <div class="bg-gradient-to-b from-gray-50 via-white to-gray-50 min-h-screen text-gray-900 selection:bg-blue-600 selection:text-white">
    
    <!-- Header Pro -->
    <header class="bg-white/80 backdrop-blur-md sticky top-0 z-50 border-b border-gray-100 shadow-xs">
      <nav class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <a href="/" class="flex items-center gap-3 group">
            <img src="/logo.jpg" alt="Vartens Logo" class="h-10 w-auto rounded-xl object-contain shadow-sm group-hover:scale-105 transition-transform" />
          </a>
          <span class="text-gray-300">/</span>
          <span class="text-sm font-medium text-gray-500 hidden sm:inline-block">Directorio de Soluciones</span>
        </div>
        <div class="flex items-center gap-6">
            <a href="/#vision" class="text-sm font-medium text-gray-600 hover:text-blue-600 transition hidden md:inline-block">Nuestra Visión</a>
            <a href="mailto:alianzas@vartens.com" class="text-sm font-medium text-gray-600 hover:text-blue-600 transition hidden md:inline-block">Contacto Alianzas</a>
            <a href="/" class="rounded-xl bg-gray-950 px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-blue-600 transition-all duration-300 hover:shadow-lg hover:shadow-blue-500/20">Volver al Inicio</a>
        </div>
      </nav>
    </header>

    <main class="max-w-7xl mx-auto px-6 py-16">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-blue-50 border border-blue-100 text-blue-700 text-xs font-semibold mb-6 tracking-wide uppercase">
          <span class="w-2 h-2 rounded-full bg-blue-600 animate-pulse"></span>
          Ecosistema Activo
        </div>
        <h1 class="text-5xl sm:text-6xl font-black tracking-tight text-gray-950 leading-[1.1]">
          Soluciones diseñadas para <span class="bg-clip-text text-transparent bg-gradient-to-r from-blue-600 to-indigo-600">escalar tu PYME</span>
        </h1>
        <p class="mt-6 text-lg text-gray-600 font-normal leading-relaxed">
          Explora nuestro ecosistema de herramientas digitales listas para usar. Cada micro-SaaS está optimizado para resolver un desafío específico de tu negocio.
        </p>

        <div class="mt-8 relative max-w-xl mx-auto">
          <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-gray-400">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
          </div>
          <input type="text" id="search-input" placeholder="Busca por nombre o categoría..." class="w-full pl-12 pr-4 py-4 bg-white border border-gray-200 rounded-2xl shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-600 focus:border-transparent text-gray-800 placeholder-gray-400 text-sm transition-all">
        </div>
      </div>

      <!-- Filtros Dinámicos -->
      <div class="mb-12 flex justify-center gap-2.5 flex-wrap" id="category-filters">
          {categories.map((cat, index) => (
              <button data-category={cat} class={`category-btn px-5 py-2.5 rounded-xl text-sm font-semibold transition-all duration-200 ${index === 0 ? 'bg-blue-600 text-white shadow-md' : 'bg-white border border-gray-200 text-gray-700'}`}>
                {cat}
              </button>
          ))}
      </div>

      <!-- Grilla de Tarjetas Dinámica -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="saas-grid">
        {saas_list.map((saas, index) => (
          <div class="saas-card bg-white p-8 rounded-3xl border border-gray-100 shadow-sm hover:shadow-xl transition-all duration-300 group flex flex-col relative overflow-hidden"
               data-category={saas.estado || 'General'}
               data-name={saas.nombre_proyecto.toLowerCase()}>
            <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-blue-600 to-indigo-600 opacity-0 group-hover:opacity-100 transition-opacity"></div>
            <div class="flex items-center justify-between mb-6">
                <span class="inline-flex items-center rounded-lg bg-blue-50/80 px-3 py-1 text-xs font-bold text-blue-700 border border-blue-100/50">
                    {saas.estado || 'General'}
                </span>
                <span class="text-gray-300 font-mono text-xl font-light group-hover:text-blue-500">#{String(index + 1).padStart(3, '0')}</span>
            </div>
            <h3 class="text-2xl font-bold text-gray-950 group-hover:text-blue-600 transition-colors">{saas.nombre_proyecto}</h3>
            <p class="mt-3 text-gray-600 text-sm leading-relaxed flex-grow">{saas.descripcion_oferta}</p>
            <div class="mt-8 pt-6 border-t border-gray-100">
              <a href={`https://${saas.subdominio}.vartens.com`} target="_blank" class="inline-flex w-full items-center justify-center rounded-xl bg-gray-900 px-5 py-3.5 text-sm font-bold text-white shadow-sm hover:bg-blue-600 transition-all duration-300">
                Conocer solución →
              </a>
            </div>
          </div>
        ))}
      </div>
    </main>

    <footer class="border-t border-gray-100 bg-white mt-24 py-12">
        <div class="max-w-7xl mx-auto px-6 text-center text-gray-500 text-sm">
            &copy; {new Date().getFullYear()} Vartens Technologies.
        </div>
    </footer>
  </div>
</Layout>

<script>
  // Script de filtrado dinámico (funciona igual pero ahora sobre los datos de Supabase)
  const searchInput = document.getElementById('search-input') as HTMLInputElement;
  const categoryBtns = document.querySelectorAll('.category-btn');
  const saasCards = document.querySelectorAll('.saas-card');

  searchInput.addEventListener('input', (e) => {
    const val = (e.target as HTMLInputElement).value.toLowerCase();
    saasCards.forEach(c => {
      const name = c.getAttribute('data-name')!;
      (c as HTMLElement).style.display = name.includes(val) ? 'flex' : 'none';
    });
  });

  categoryBtns.forEach(btn => btn.addEventListener('click', () => {
    const cat = btn.getAttribute('data-category')!;
    categoryBtns.forEach(b => b.classList.replace('bg-blue-600', 'bg-white'));
    btn.classList.replace('bg-white', 'bg-blue-600');
    saasCards.forEach(c => {
      const cardCat = c.getAttribute('data-category')!;
      (c as HTMLElement).style.display = (cat === 'Todos' || cardCat === cat) ? 'flex' : 'none';
    });
  }));
</script>
