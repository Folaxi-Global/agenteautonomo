---
import Layout from '../layouts/Layout.astro';
import { createClient } from '@supabase/supabase-js';

const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL || import.meta.env.SUPABASE_URL || process.env.PUBLIC_SUPABASE_URL || process.env.SUPABASE_URL;
const supabaseKey = import.meta.env.NEXT_PUBLIC_SUPABASE_ANON_KEY || import.meta.env.SUPABASE_ANON_KEY || process.env.NEXT_PUBLIC_SUPABASE_ANON_KEY || process.env.SUPABASE_ANON_KEY;

let saas_list = [];

if (supabaseUrl && supabaseKey) {
  try {
    const supabase = createClient(supabaseUrl, supabaseKey);
    const { data } = await supabase
      .from('proyectos')
      .select('*')
      .order('fecha_creacion', { ascending: false });
    
    if (data) {
      saas_list = data;
    }
  } catch (e) {
    console.error("Error:", e);
  }
}

const categories = ['Todos', ...new Set(saas_list.map(item => item.estado || 'General'))];
---

<Layout title="Directorio de Soluciones Vartens">
  <div class="min-h-screen bg-slate-50 text-slate-900 selection:bg-blue-600 selection:text-white">
    
    <!-- Header Pro con tamaño de logo controlado -->
    <header class="sticky top-0 z-50 bg-white/80 backdrop-blur-md border-b border-slate-200">
      <nav class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">
        <a href="/" class="flex items-center gap-3 group">
          <img src="/logo.jpg" alt="Vartens Logo" class="h-10 w-auto rounded-xl object-contain shadow-sm" />
          <span class="font-bold text-lg tracking-tight text-slate-900">Vartens</span>
        </a>
        <a href="/" class="rounded-xl bg-slate-950 px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-blue-600 transition-all">Volver al Inicio</a>
      </nav>
    </header>

    <main class="max-w-7xl mx-auto px-6 py-16">
      
      <!-- Sección Título y Filtros -->
      <div class="text-center max-w-3xl mx-auto mb-16 space-y-6">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-blue-50 border border-blue-100 text-blue-700 text-xs font-bold tracking-wide uppercase">
          <span class="w-2 h-2 rounded-full bg-blue-600 animate-pulse"></span>
          Ecosistema Activo ({saas_list.length} Soluciones)
        </div>
        
        <h1 class="text-4xl sm:text-6xl font-black tracking-tight text-slate-950">
          Soluciones diseñadas para <span class="text-blue-600">escalar tu PYME</span>
        </h1>
        
        <p class="text-slate-600 text-lg">
          Explora nuestro ecosistema de herramientas digitales listas para usar.
        </p>

        <!-- Buscador y Desplegable Pro -->
        <div class="flex flex-col sm:flex-row gap-3 justify-center items-center max-w-2xl mx-auto pt-4">
          <input type="text" id="search-input" placeholder="Buscar por nombre de solución..." class="w-full sm:flex-grow px-5 py-3.5 bg-white border border-slate-200 rounded-2xl shadow-xs focus:ring-2 focus:ring-blue-600 outline-none text-sm text-slate-800">
          
          <select id="category-select" class="w-full sm:w-56 px-4 py-3.5 bg-white border border-slate-200 rounded-2xl shadow-xs focus:ring-2 focus:ring-blue-600 outline-none text-sm font-medium text-slate-700 cursor-pointer">
            {categories.map(cat => <option value={cat}>{cat}</option>)}
          </select>
        </div>
      </div>

      <!-- Grilla de Tarjetas -->
      {saas_list.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="saas-grid">
          {saas_list.map((saas, index) => (
            <div class="saas-card bg-white p-8 rounded-3xl border border-slate-200 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col justify-between group relative overflow-hidden"
                 data-category={saas.estado || 'General'}
                 data-name={(saas.nombre_proyecto || '').toLowerCase()}>
              
              <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-blue-600 to-indigo-600 opacity-0 group-hover:opacity-100 transition-opacity"></div>
              
              <div>
                <div class="flex items-center justify-between mb-4">
                  <span class="inline-flex items-center rounded-lg bg-blue-50 px-3 py-1 text-xs font-bold text-blue-700 border border-blue-100">
                    {saas.estado || 'Activo'}
                  </span>
                  <span class="text-slate-300 font-mono text-sm">#{String(index + 1).padStart(3, '0')}</span>
                </div>

                <h3 class="text-2xl font-bold text-slate-950 group-hover:text-blue-600 transition-colors mb-3">
                  {saas.nombre_proyecto || 'Sin Nombre'}
                </h3>
                
                <p class="text-slate-600 text-sm leading-relaxed">
                  {saas.descripcion_oferta || 'Sin descripción disponible.'}
                </p>
              </div>

              <div class="mt-8 pt-6 border-t border-slate-100">
                <a href={`https://${saas.subdominio}.vartens.com`} target="_blank" rel="noopener noreferrer" 
                   class="inline-flex w-full items-center justify-center rounded-xl bg-slate-900 px-5 py-3.5 text-sm font-bold text-white shadow-sm hover:bg-blue-600 transition-all">
                  Conocer solución →
                </a>
              </div>
            </div>
          ))}
        </div>
      ) : (
        <div class="text-center py-24 bg-white rounded-3xl border border-dashed border-slate-200 max-w-xl mx-auto">
          <h3 class="text-xl font-bold text-slate-800">No hay proyectos sincronizados</h3>
          <p class="mt-2 text-sm text-slate-500">Verifica la conexión con Supabase.</p>
        </div>
      )}

      <!-- Estado vacío para el buscador -->
      <div id="no-results" class="hidden text-center py-20 text-slate-500 bg-white rounded-3xl border border-slate-200 mt-6 shadow-sm">
        <h3 class="text-lg font-bold text-slate-800">No se encontraron coincidencias</h3>
      </div>

    </main>

    <footer class="border-t border-slate-100 bg-white mt-24 py-12 text-center text-sm text-slate-500">
        &copy; {new Date().getFullYear()} Vartens Technologies. Todos los derechos reservados.
    </footer>
  </div>
</Layout>

<script>
  const searchInput = document.getElementById('search-input') as HTMLInputElement;
  const categorySelect = document.getElementById('category-select') as HTMLSelectElement;
  const saasCards = document.querySelectorAll('.saas-card');
  const noResults = document.getElementById('no-results');

  const filterCards = () => {
    const query = searchInput.value.toLowerCase().trim();
    const selectedCat = categorySelect.value;
    let visibleCount = 0;

    saasCards.forEach((card) => {
      const name = card.getAttribute('data-name') || '';
      const category = card.getAttribute('data-category') || '';

      const matchesSearch = name.includes(query);
      const matchesCategory = selectedCat === 'Todos' || category === selectedCat;

      if (matchesSearch && matchesCategory) {
        (card as HTMLElement).style.display = 'flex';
        visibleCount++;
      } else {
        (card as HTMLElement).style.display = 'none';
      }
    });

    if (noResults) {
      noResults.classList.toggle('hidden', visibleCount > 0);
    }
  };

  searchInput?.addEventListener('input', filterCards);
  categorySelect?.addEventListener('change', filterCards);
</script>
