---
import Layout from '../layouts/Layout.astro';

// Datos de ejemplo optimizados
const saas_list = [
    { id: 1, name: 'SaaS Ventas Rápidas', description: 'CRM simple y automatizado para PYMEs de servicios en crecimiento.', category: 'Ventas', url: '#' },
    { id: 2, name: 'SaaS Cobranza Pro', description: 'Automatiza facturas vencidas, recordatorios y seguimiento de pagos.', category: 'Finanzas', url: '#' },
    { id: 3, name: 'SaaS RRHH Fácil', description: 'Gestión inteligente de personal, asistencia y nómina básica.', category: 'Operaciones', url: '#' },
    { id: 4, name: 'SaaS Inventario Bot', description: 'Control de stock en tiempo real con alertas de reabastecimiento inteligente.', category: 'Operaciones', url: '#' },
    { id: 5, name: 'SaaS Marketing Local', description: 'Campañas y anuncios automatizados para potenciar negocios físicos.', category: 'Marketing', url: '#' },
];

const categories = ['Todos', ...new Set(saas_list.map(item => item.category))];
---

<Layout title="Directorio de Soluciones Vartens">
  <div class="bg-gradient-to-b from-gray-50 via-white to-gray-50 min-h-screen text-gray-900 selection:bg-blue-600 selection:text-white">
    
    <!-- Header Pro con el Logo Oficial -->
    <header class="bg-white/80 backdrop-blur-md sticky top-0 z-50 border-b border-gray-100 shadow-xs">
      <nav class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <a href="/" class="flex items-center gap-3 group">
            <!-- Logo oficial de Vartens (Asegúrate de guardar la imagen como logo.jpg o logo.png en vartens_hub/public/) -->
            <img src="/logo.jpg" alt="Vartens Logo" class="h-10 w-auto rounded-xl object-contain shadow-sm group-hover:scale-105 transition-transform" />
          </a>
          <span class="text-gray-300">/</span>
          <span class="text-sm font-medium text-gray-500 hidden sm:inline-block">Directorio de Soluciones</span>
        </div>
        <div class="flex items-center gap-6">
            <a href="/#vision" class="text-sm font-medium text-gray-600 hover:text-blue-600 transition hidden md:inline-block">Nuestra Visión</a>
            <a href="mailto:alianzas@vartens.com" class="text-sm font-medium text-gray-600 hover:text-blue-600 transition hidden md:inline-block">Contacto Alianzas</a>
            <a href="/" class="rounded-xl bg-gray-950 px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-blue-600 transition-all duration-300 hover:shadow-lg hover:shadow-blue-500/20">Volver al Inicio</a>
        </div>
      </nav>
    </header>

    <main class="max-w-7xl mx-auto px-6 py-16">
      
      <!-- Título y buscador -->
      <div class="text-center max-w-3xl mx-auto mb-16">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-blue-50 border border-blue-100 text-blue-700 text-xs font-semibold mb-6 tracking-wide uppercase">
          <span class="w-2 h-2 rounded-full bg-blue-600 animate-pulse"></span>
          Ecosistema Activo
        </div>
        <h1 class="text-5xl sm:text-6xl font-black tracking-tight text-gray-950 leading-[1.1]">
          Soluciones diseñadas para <span class="bg-clip-text text-transparent bg-gradient-to-r from-blue-600 to-indigo-600">escalar tu PYME</span>
        </h1>
        <p class="mt-6 text-lg text-gray-600 font-normal leading-relaxed">
          Explora nuestro ecosistema de herramientas digitales listas para usar. Cada micro-SaaS está optimizado para resolver un desafío específico de tu negocio.
        </p>

        <!-- Barra de búsqueda interactiva -->
        <div class="mt-8 relative max-w-xl mx-auto">
          <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-gray-400">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
          </div>
          <input 
            type="text" 
            id="search-input" 
            placeholder="Busca por nombre o categoría de solución..." 
            class="w-full pl-12 pr-4 py-4 bg-white border border-gray-200 rounded-2xl shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-600 focus:border-transparent text-gray-800 placeholder-gray-400 text-sm transition-all"
          >
        </div>
      </div>

      <!-- Filtros Dinámicos por Categoría -->
      <div class="mb-12 flex justify-center gap-2.5 flex-wrap" id="category-filters">
          {categories.map((cat, index) => (
              <button 
                data-category={cat}
                class={`category-btn px-5 py-2.5 rounded-xl text-sm font-semibold transition-all duration-200 shadow-xs ${index === 0 ? 'bg-blue-600 text-white shadow-blue-500/20 shadow-md' : 'bg-white border border-gray-200 text-gray-700 hover:border-gray-300 hover:bg-gray-50'}`}
              >
                {cat}
              </button>
          ))}
      </div>

      <!-- Grilla de Tarjetas -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="saas-grid">
        {saas_list.map((saas) => (
          <div 
            class="saas-card bg-white p-8 rounded-3xl border border-gray-100 shadow-sm hover:shadow-xl transition-all duration-300 hover:-translate-y-1.5 group flex flex-col relative overflow-hidden"
            data-category={saas.category}
            data-name={saas.name.toLowerCase()}
            data-description={saas.description.toLowerCase()}
          >
            <!-- Línea superior decorativa con gradiente al hacer hover -->
            <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-blue-600 to-indigo-600 opacity-0 group-hover:opacity-100 transition-opacity"></div>

            <div class="flex items-center justify-between mb-6">
                <span class="inline-flex items-center rounded-lg bg-blue-50/80 px-3 py-1 text-xs font-bold text-blue-700 border border-blue-100/50">
                    {saas.category}
                </span>
                <span class="text-gray-300 font-mono text-xl font-light group-hover:text-blue-500 transition-colors">
                    #{String(saas.id).padStart(3, '0')}
                </span>
            </div>
            
            <h3 class="text-2xl font-bold text-gray-950 group-hover:text-blue-600 transition-colors">{saas.name}</h3>
            <p class="mt-3 text-gray-600 text-sm leading-relaxed flex-grow">{saas.description}</p>
            
            <div class="mt-8 pt-6 border-t border-gray-100">
              <a href={saas.url} class="inline-flex w-full items-center justify-center rounded-xl bg-gray-900 px-5 py-3.5 text-sm font-bold text-white shadow-sm hover:bg-blue-600 transition-all duration-300 group-hover:shadow-lg group-hover:shadow-blue-500/25">
                Conocer solución <span class="ml-2 transition-transform group-hover:translate-x-1">→</span>
              </a>
            </div>
          </div>
        ))}
      </div>

      <!-- Estado vacío (Oculto por defecto, manejado por JS) -->
      <div id="no-results" class="hidden text-center py-24 border border-dashed border-gray-200 rounded-3xl bg-white mt-4">
        <svg class="w-16 h-16 mx-auto text-gray-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        <h3 class="text-xl font-bold text-gray-900">No encontramos resultados</h3>
        <p class="mt-2 text-sm text-gray-500">Prueba buscando con otras palabras clave o categorías.</p>
      </div>

    </main>

    <!-- Footer Pro -->
     <footer class="border-t border-gray-100 bg-white mt-24 py-12">
        <div class="max-w-7xl mx-auto px-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-gray-500 text-sm">
            <p>&copy; {new Date().getFullYear()} Vartens Technologies. Todos los derechos reservados.</p>
            <div class="flex items-center gap-6">
              <a href="/" class="hover:text-blue-600 transition">Inicio</a>
              <a href="mailto:alianzas@vartens.com" class="hover:text-blue-600 transition">Soporte y Alianzas</a>
            </div>
        </div>
    </footer>
  </div>
</Layout>

<!-- Script ultraligero para filtrado y búsqueda en tiempo real -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('search-input') as HTMLInputElement;
    const categoryBtns = document.querySelectorAll('.category-btn');
    const saasCards = document.querySelectorAll('.saas-card');
    const noResults = document.getElementById('no-results');

    let currentCategory = 'Todos';
    let searchQuery = '';

    function filterCards() {
      let visibleCount = 0;

      saasCards.forEach((card) => {
        const category = card.getAttribute('data-category');
        const name = card.getAttribute('data-name') || '';
        const description = card.getAttribute('data-description') || '';

        const matchesCategory = currentCategory === 'Todos' || category === currentCategory;
        const matchesSearch = name.includes(searchQuery) || description.includes(searchQuery);

        if (matchesCategory && matchesSearch) {
          (card as HTMLElement).style.display = 'flex';
          visibleCount++;
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });

      if (noResults) {
        if (visibleCount === 0) {
          noResults.classList.remove('hidden');
        } else {
          noResults.classList.add('hidden');
        }
      }
    }

    // Evento de búsqueda
    searchInput?.addEventListener('input', (e) => {
      searchQuery = (e.target as HTMLInputElement).value.toLowerCase().trim();
      filterCards();
    });

    // Evento de categorías
    categoryBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        categoryBtns.forEach(b => {
          b.classList.remove('bg-blue-600', 'text-white', 'shadow-blue-500/20', 'shadow-md');
          b.classList.add('bg-white', 'border', 'border-gray-200', 'text-gray-700');
        });
        
        btn.classList.remove('bg-white', 'border', 'border-gray-200', 'text-gray-700');
        btn.classList.add('bg-blue-600', 'text-white', 'shadow-blue-500/20', 'shadow-md');

        currentCategory = btn.getAttribute('data-category') || 'Todos';
        filterCards();
      });
    });
  });
</script>

<style>
    body {
        font-family: Inter, system-ui, -apple-system, sans-serif;
    }
</style>
