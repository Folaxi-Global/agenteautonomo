---
import Layout from '../layouts/Layout.astro';
import { createClient } from '@supabase/supabase-js';

// Conexión dinámica
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL || process.env.PUBLIC_SUPABASE_URL;
const supabaseKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY || process.env.PUBLIC_SUPABASE_ANON_KEY;

let saas_list = [];
let debugStatus = "";

if (supabaseUrl && supabaseKey) {
  try {
    const supabase = createClient(supabaseUrl, supabaseKey);
    const { data, error } = await supabase
      .from('proyectos')
      .select('*')
      .order('fecha_creacion', { ascending: false });
    
    if (error) debugStatus = "Error: " + error.message;
    else {
      saas_list = data || [];
      debugStatus = `Conectado. Total: ${saas_list.length}`;
    }
  } catch (e: any) { debugStatus = "Error: " + e.message; }
}

// Extraer categorías únicas para el desplegable
const categories = ['Todos', ...new Set(saas_list.map(item => item.estado || 'General'))];
---

<Layout title="Directorio de Soluciones Vartens">
  <div class="bg-gradient-to-b from-gray-50 via-white to-gray-50 min-h-screen text-gray-900 selection:bg-blue-600 selection:text-white">
    
    <!-- Header Pro -->
    <header class="bg-white/80 backdrop-blur-md sticky top-0 z-50 border-b border-gray-100 shadow-xs">
      <nav class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <a href="/" class="flex items-center gap-3 group">
            <img src="/logo.jpg" alt="Vartens Logo" class="h-10 w-auto rounded-xl object-contain shadow-sm" />
          </a>
          <span class="text-sm font-medium text-gray-500 hidden sm:inline-block">/ Directorio</span>
        </div>
        <a href="/" class="rounded-xl bg-gray-950 px-5 py-2.5 text-sm font-semibold text-white hover:bg-blue-600 transition-all">Volver al Inicio</a>
      </nav>
    </header>

    <main class="max-w-7xl mx-auto px-6 py-16">
      <!-- Diagnóstico oculto -->
      <div class="mb-8 p-3 rounded-xl bg-slate-900 text-emerald-400 font-mono text-xs max-w-xl mx-auto text-center hidden">
        ⚡ {debugStatus}
      </div>

      <div class="text-center max-w-3xl mx-auto mb-16">
        <h1 class="text-5xl font-black tracking-tight text-gray-950 mb-6">Soluciones para escalar tu PYME</h1>
        
        <!-- Buscador y Desplegable -->
        <div class="flex flex-col sm:flex-row gap-4 justify-center items-center max-w-xl mx-auto">
          <input type="text" id="search-input" placeholder="Buscar por nombre..." class="w-full px-5 py-3 bg-white border border-gray-200 rounded-xl shadow-sm focus:ring-2 focus:ring-blue-600 outline-none text-sm">
          
          <select id="category-select" class="w-full sm:w-60 px-5 py-3 bg-white border border-gray-200 rounded-xl shadow-sm focus:ring-2 focus:ring-blue-600 outline-none text-sm cursor-pointer text-gray-700">
            {categories.map(cat => <option value={cat}>{cat}</option>)}
          </select>
        </div>
      </div>

      <!-- Grilla de Tarjetas -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="saas-grid">
        {saas_list.map((saas, index) => (
          <div class="saas-card bg-white p-8 rounded-3xl border border-gray-100 shadow-sm hover:shadow-xl transition-all duration-300 group flex flex-col"
               data-category={saas.estado || 'General'}
               data-name={saas.nombre_proyecto?.toLowerCase() || ''}>
            <span class="inline-block px-3 py-1 mb-4 text-xs font-bold bg-blue-50 text-blue-700 rounded-full w-max">{saas.estado || 'General'}</span>
            <h3 class="text-2xl font-bold text-gray-950 group-hover:text-blue-600">{saas.nombre_proyecto || 'Sin nombre'}</h3>
            <p class="mt-3 text-gray-600 text-sm leading-relaxed flex-grow">{saas.descripcion_oferta || 'Sin descripción.'}</p>
            <a href={`https://${saas.subdominio || 'app'}.vartens.com`} target="_blank" class="mt-8 block w-full text-center rounded-xl bg-gray-900 py-3.5 text-sm font-bold text-white hover:bg-blue-600 transition-all">
              Conocer solución →
            </a>
          </div>
        ))}
      </div>
    </main>
  </div>
</Layout>

<script>
  const searchInput = document.getElementById('search-input') as HTMLInputElement;
  const categorySelect = document.getElementById('category-select') as HTMLSelectElement;
  const saasCards = document.querySelectorAll('.saas-card');

  const filter = () => {
    const sVal = searchInput.value.toLowerCase();
    const cVal = categorySelect.value;
    saasCards.forEach(c => {
      const name = c.getAttribute('data-name') || '';
      const cat = c.getAttribute('data-category') || '';
      const matchS = name.includes(sVal);
      const matchC = (cVal === 'Todos' || cat === cVal);
      (c as HTMLElement).style.display = (matchS && matchC) ? 'flex' : 'none';
    });
  };

  searchInput.addEventListener('input', filter);
  categorySelect.addEventListener('change', filter);
</script>
